<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Построй свой дом</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #1a1a2e;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      overflow: hidden;
      user-select: none;
    }

    .game-wrapper {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    canvas {
      border: 3px solid #4a5568;
      border-radius: 10px;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
      image-rendering: pixelated;
      background: #87CEEB;
    }

    .panel {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      padding: 1.2rem;
      color: white;
      width: 240px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .panel h2 {
      text-align: center;
      margin-bottom: 1rem;
      font-size: 1.3rem;
      color: #ffd700;
    }

    .inventory-slot {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.7rem;
      margin: 0.3rem 0;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
      border: 2px solid transparent;
      background: rgba(255, 255, 255, 0.05);
    }

    .inventory-slot:hover {
      background: rgba(255, 255, 255, 0.15);
      transform: scale(1.02);
    }

    .inventory-slot.selected {
      border-color: #ffd700;
      background: rgba(255, 215, 0, 0.2);
      box-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
    }

    .slot-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .slot-info {
      flex: 1;
    }

    .slot-name {
      font-weight: bold;
      font-size: 0.9rem;
    }

    .slot-count {
      font-size: 0.8rem;
      color: #aaa;
    }

    .resources {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .resource-item {
      display: flex;
      justify-content: space-between;
      padding: 0.3rem 0;
      font-size: 0.9rem;
    }

    .help-text {
      margin-top: 1rem;
      font-size: 0.8rem;
      color: #aaa;
      text-align: center;
      line-height: 1.5;
    }

    .help-text span {
      color: #ffd700;
    }

    .message {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0, 0, 0, 0.8);
      color: #ffd700;
      padding: 0.8rem 1.5rem;
      border-radius: 25px;
      font-weight: bold;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s;
      z-index: 100;
    }

    .message.show {
      opacity: 1;
    }
  </style>
</head>
<body>
  <div class="message" id="message"></div>
  
  <div class="game-wrapper">
    <canvas id="gameCanvas"></canvas>
    
    <div class="panel">
      <h2>🏗️ Инструменты</h2>
      
      <div class="inventory-slot selected" data-item="wood-wall" id="slot-wood-wall">
        <div class="slot-icon" style="background: #8B4513;">🪵</div>
        <div class="slot-info">
          <div class="slot-name">Деревянная стена</div>
          <div class="slot-count">Нужно: 2 дерева</div>
        </div>
      </div>

      <div class="inventory-slot" data-item="stone-wall" id="slot-stone-wall">
        <div class="slot-icon" style="background: #808080;">🪨</div>
        <div class="slot-info">
          <div class="slot-name">Каменная стена</div>
          <div class="slot-count">Нужно: 2 камня</div>
        </div>
      </div>

      <div class="inventory-slot" data-item="roof" id="slot-roof">
        <div class="slot-icon" style="background: #8B0000;">🔺</div>
        <div class="slot-info">
          <div class="slot-name">Крыша</div>
          <div class="slot-count">Нужно: 3 дерева</div>
        </div>
      </div>

      <div class="inventory-slot" data-item="door" id="slot-door">
        <div class="slot-icon" style="background: #654321;">🚪</div>
        <div class="slot-info">
          <div class="slot-name">Дверь</div>
          <div class="slot-count">Нужно: 3 дерева</div>
        </div>
      </div>

      <div class="inventory-slot" data-item="window" id="slot-window">
        <div class="slot-icon" style="background: #87CEEB;">🪟</div>
        <div class="slot-info">
          <div class="slot-name">Окно</div>
          <div class="slot-count">Нужно: 1 дерево</div>
        </div>
      </div>

      <div class="inventory-slot" data-item="remove" id="slot-remove">
        <div class="slot-icon" style="background: #ff4444;">💥</div>
        <div class="slot-info">
          <div class="slot-name">Сломать</div>
          <div class="slot-count">Удалить блок</div>
        </div>
      </div>

      <div class="resources">
        <h3 style="font-size: 1rem; margin-bottom: 0.5rem;">📦 Ресурсы</h3>
        <div class="resource-item">
          <span>🪵 Дерево:</span>
          <span id="wood-count">0</span>
        </div>
        <div class="resource-item">
          <span>🪨 Камень:</span>
          <span id="stone-count">0</span>
        </div>
      </div>

      <div class="help-text">
        <span>WASD / Стрелки</span> — движение<br>
        <span>Пробел</span> — прыжок<br>
        <span>Клик мыши</span> — строить/ломать<br>
        <span>Руби деревья и добывай камень!</span>
      </div>
    </div>
  </div>

  <script>
    // === НАСТРОЙКИ ===
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const messageEl = document.getElementById('message');

    const BLOCK_SIZE = 32;
    const WORLD_WIDTH = 40;
    const WORLD_HEIGHT = 22;
    
    canvas.width = WORLD_WIDTH * BLOCK_SIZE;
    canvas.height = WORLD_HEIGHT * BLOCK_SIZE;

    // === ТИПЫ БЛОКОВ ===
    const BLOCKS = {
      AIR: 0,
      DIRT: 1,
      GRASS: 2,
      WOOD_WALL: 3,
      STONE_WALL: 4,
      ROOF: 5,
      DOOR: 6,
      WINDOW: 7,
      TREE_TRUNK: 8,
      TREE_LEAVES: 9,
      STONE_ORE: 10,
    };

    const BLOCK_COLORS = {
      [BLOCKS.AIR]: null,
      [BLOCKS.DIRT]: '#8B4513',
      [BLOCKS.GRASS]: '#228B22',
      [BLOCKS.WOOD_WALL]: '#DEB887',
      [BLOCKS.STONE_WALL]: '#808080',
      [BLOCKS.ROOF]: '#8B0000',
      [BLOCKS.DOOR]: '#654321',
      [BLOCKS.WINDOW]: '#ADD8E6',
      [BLOCKS.TREE_TRUNK]: '#654321',
      [BLOCKS.TREE_LEAVES]: '#2E8B57',
      [BLOCKS.STONE_ORE]: '#696969',
    };

    // === МИР ===
    let world = [];
    let resources = { wood: 0, stone: 0 };

    function initWorld() {
      world = Array.from({ length: WORLD_HEIGHT }, () => Array(WORLD_WIDTH).fill(BLOCKS.AIR));
      
      // Земля и трава
      for (let y = WORLD_HEIGHT - 5; y < WORLD_HEIGHT; y++) {
        for (let x = 0; x < WORLD_WIDTH; x++) {
          world[y][x] = y === WORLD_HEIGHT - 5 ? BLOCKS.GRASS : BLOCKS.DIRT;
        }
      }

      // Деревья
      const treePositions = [3, 8, 15, 22, 28, 33, 37];
      treePositions.forEach(x => {
        const groundY = WORLD_HEIGHT - 6;
        // Ствол
        for (let y = groundY - 3; y <= groundY; y++) {
          world[y][x] = BLOCKS.TREE_TRUNK;
        }
        // Листья
        world[groundY - 4][x] = BLOCKS.TREE_LEAVES;
        world[groundY - 4][x - 1] = BLOCKS.TREE_LEAVES;
        world[groundY - 4][x + 1] = BLOCKS.TREE_LEAVES;
        world[groundY - 5][x] = BLOCKS.TREE_LEAVES;
      });

      // Камни
      const stonePositions = [
        [5, WORLD_HEIGHT - 5],
        [12, WORLD_HEIGHT - 5],
        [20, WORLD_HEIGHT - 5],
        [25, WORLD_HEIGHT - 5],
        [30, WORLD_HEIGHT - 5],
      ];
      stonePositions.forEach(([x, y]) => {
        if (world[y][x] === BLOCKS.AIR || world[y][x] === BLOCKS.GRASS) {
          world[y][x] = BLOCKS.STONE_ORE;
        }
      });
    }

    // === ИГРОК ===
    const player = {
      x: 3 * BLOCK_SIZE,
      y: (WORLD_HEIGHT - 7) * BLOCK_SIZE,
      width: 24,
      height: 40,
      vx: 0,
      vy: 0,
      speed: 4,
      jumpForce: -8,
      onGround: false,
      facing: 1, // 1 - вправо, -1 - влево
    };

    const gravity = 0.5;

    // === ВВОД ===
    const keys = {};
    let selectedItem = 'wood-wall';
    let mouseX = 0;
    let mouseY = 0;
    let messageTimeout = null;

    window.addEventListener('keydown', e => {
      keys[e.key] = true;
      if (e.key === ' ' || e.key === 'ArrowUp') e.preventDefault();
    });

    window.addEventListener('keyup', e => {
      keys[e.key] = false;
    });

    canvas.addEventListener('mousemove', e => {
      const rect = canvas.getBoundingClientRect();
      mouseX = Math.floor((e.clientX - rect.left) / BLOCK_SIZE);
      mouseY = Math.floor((e.clientY - rect.top) / BLOCK_SIZE);
    });

    canvas.addEventListener('click', e => {
      if (mouseX < 0 || mouseX >= WORLD_WIDTH || mouseY < 0 || mouseY >= WORLD_HEIGHT) return;
      handleBlockInteraction(mouseX, mouseY);
    });

    // === ИНВЕНТАРЬ ===
    document.querySelectorAll('.inventory-slot').forEach(slot => {
      slot.addEventListener('click', () => {
        document.querySelectorAll('.inventory-slot').forEach(s => s.classList.remove('selected'));
        slot.classList.add('selected');
        selectedItem = slot.dataset.item;
      });
    });

    // === ФУНКЦИИ СТРОИТЕЛЬСТВА ===
    function showMessage(text) {
      messageEl.textContent = text;
      messageEl.classList.add('show');
      if (messageTimeout) clearTimeout(messageTimeout);
      messageTimeout = setTimeout(() => messageEl.classList.remove('show'), 2000);
    }

    function canPlaceBlock(x, y) {
      if (x < 0 || x >= WORLD_WIDTH || y < 0 || y >= WORLD_HEIGHT) return false;
      // Нельзя строить там, где игрок
      const px = Math.floor(player.x / BLOCK_SIZE);
      const py = Math.floor(player.y / BLOCK_SIZE);
      const playerBottom = Math.floor((player.y + player.height) / BLOCK_SIZE);
      if ((x === px || x === px + 1) && (y === py || y === playerBottom)) return false;
      return world[y][x] === BLOCKS.AIR;
    }

    function handleBlockInteraction(x, y) {
      if (selectedItem === 'remove') {
        removeBlock(x, y);
        return;
      }

      const block = world[y][x];
      // Сбор ресурсов
      if (block === BLOCKS.TREE_TRUNK || block === BLOCKS.TREE_LEAVES) {
        chopTree(x, y);
        return;
      }
      if (block === BLOCKS.STONE_ORE) {
        mineStone(x, y);
        return;
      }

      // Строительство
      placeBlock(x, y);
    }

    function removeBlock(x, y) {
      const block = world[y][x];
      if (block === BLOCKS.AIR || block === BLOCKS.DIRT || block === BLOCKS.GRASS) return;
      if (block === BLOCKS.TREE_TRUNK || block === BLOCKS.TREE_LEAVES) {
        chopTree(x, y);
        return;
      }
      if (block === BLOCKS.STONE_ORE) {
        mineStone(x, y);
        return;
      }
      
      // Возврат ресурсов
      if (block === BLOCKS.WOOD_WALL) resources.wood += 1;
      if (block === BLOCKS.STONE_WALL) resources.stone += 1;
      if (block === BLOCKS.ROOF) resources.wood += 2;
      if (block === BLOCKS.DOOR) resources.wood += 2;
      if (block === BLOCKS.WINDOW) resources.wood += 1;
      
      world[y][x] = BLOCKS.AIR;
      showMessage('Блок сломан! 🔨');
      updateResourceDisplay();
    }

    function placeBlock(x, y) {
      if (!canPlaceBlock(x, y)) {
        showMessage('Здесь нельзя строить! ❌');
        return;
      }

      const recipes = {
        'wood-wall': { block: BLOCKS.WOOD_WALL, cost: { wood: 2 } },
        'stone-wall': { block: BLOCKS.STONE_WALL, cost: { stone: 2 } },
        'roof': { block: BLOCKS.ROOF, cost: { wood: 3 } },
        'door': { block: BLOCKS.DOOR, cost: { wood: 3 } },
        'window': { block: BLOCKS.WINDOW, cost: { wood: 1 } },
      };

      const recipe = recipes[selectedItem];
      if (!recipe) return;

      // Проверка ресурсов
      for (const [res, amount] of Object.entries(recipe.cost)) {
        if (resources[res] < amount) {
          showMessage(`Не хватает ${res === 'wood' ? 'дерева' : 'камня'}! 🌳`);
          return;
        }
      }

      // Списываем ресурсы
      for (const [res, amount] of Object.entries(recipe.cost)) {
        resources[res] -= amount;
      }

      world[y][x] = recipe.block;
      showMessage('Построено! ✅');
      updateResourceDisplay();
    }

    function chopTree(x, y) {
      // Рубим всё дерево
      const toRemove = [];
      const visited = new Set();
      
      function floodFill(cx, cy, targetBlocks) {
        if (cx < 0 || cx >= WORLD_WIDTH || cy < 0 || cy >= WORLD_HEIGHT) return;
        const key = `${cx},${cy}`;
        if (visited.has(key)) return;
        if (!targetBlocks.includes(world[cy][cx])) return;
        visited.add(key);
        toRemove.push([cx, cy]);
        floodFill(cx + 1, cy, targetBlocks);
        floodFill(cx - 1, cy, targetBlocks);
        floodFill(cx, cy + 1, targetBlocks);
        floodFill(cx, cy - 1, targetBlocks);
      }

      floodFill(x, y, [BLOCKS.TREE_TRUNK, BLOCKS.TREE_LEAVES]);

      let woodGained = 0;
      toRemove.forEach(([cx, cy]) => {
        if (world[cy][cx] === BLOCKS.TREE_TRUNK) woodGained += 2;
        if (world[cy][cx] === BLOCKS.TREE_LEAVES) woodGained += 1;
        world[cy][cx] = BLOCKS.AIR;
      });

      resources.wood += woodGained;
      showMessage(`+${woodGained} дерева! 🪓`);
      updateResourceDisplay();
    }

    function mineStone(x, y) {
      world[y][x] = BLOCKS.AIR;
      resources.stone += 3;
      showMessage('+3 камня! ⛏️');
      updateResourceDisplay();
    }

    function updateResourceDisplay() {
      document.getElementById('wood-count').textContent = resources.wood;
      document.getElementById('stone-count').textContent = resources.stone;
    }

    // === ФИЗИКА ИГРОКА ===
    function updatePlayer() {
      // Горизонтальное движение
      if (keys['ArrowLeft'] || keys['a'] || keys['A'] || keys['ф'] || keys['Ф']) {
        player.vx = -player.speed;
        player.facing = -1;
      } else if (keys['ArrowRight'] || keys['d'] || keys['D'] || keys['в'] || keys['В']) {
        player.vx = player.speed;
        player.facing = 1;
      } else {
        player.vx *= 0.7;
        if (Math.abs(player.vx) < 0.1) player.vx = 0;
      }

      // Прыжок
      if ((keys[' '] || keys['ArrowUp'] || keys['w'] || keys['W'] || keys['ц'] || keys['Ц']) && player.onGround) {
        player.vy = player.jumpForce;
        player.onGround = false;
      }

      // Гравитация
      player.vy += gravity;
      if (player.vy > 15) player.vy = 15;

      // Перемещение по X с коллизией
      player.x += player.vx;
      resolveCollisionX();

      // Перемещение по Y с коллизией
      player.y += player.vy;
      player.onGround = false;
      resolveCollisionY();

      // Границы мира
      if (player.x < 0) player.x = 0;
      if (player.x + player.width > WORLD_WIDTH * BLOCK_SIZE) player.x = WORLD_WIDTH * BLOCK_SIZE - player.width;
      if (player.y > WORLD_HEIGHT * BLOCK_SIZE) {
        player.y = (WORLD_HEIGHT - 7) * BLOCK_SIZE;
        player.vy = 0;
      }
    }

    function getBlockAt(px, py) {
      const bx = Math.floor(px / BLOCK_SIZE);
      const by = Math.floor(py / BLOCK_SIZE);
      if (bx < 0 || bx >= WORLD_WIDTH || by < 0 || by >= WORLD_HEIGHT) return BLOCKS.DIRT;
      const block = world[by][bx];
      return (block === BLOCKS.AIR || block === BLOCKS.DOOR || block === BLOCKS.WINDOW) ? BLOCKS.AIR : block;
    }

    function resolveCollisionX() {
      const left = player.x;
      const right = player.x + player.width;
      const top = player.y + 2;
      const bottom = player.y + player.height - 2;

      if (player.vx > 0 && getBlockAt(right, top) !== BLOCKS.AIR || getBlockAt(right, bottom) !== BLOCKS.AIR) {
        player.x = Math.floor(right / BLOCK_SIZE) * BLOCK_SIZE - player.width;
        player.vx = 0;
      }
      if (player.vx < 0 && getBlockAt(left, top) !== BLOCKS.AIR || getBlockAt(left, bottom) !== BLOCKS.AIR) {
        player.x = Math.floor(left / BLOCK_SIZE) * BLOCK_SIZE + BLOCK_SIZE;
        player.vx = 0;
      }
    }

    function resolveCollisionY() {
      const left = player.x + 2;
      const right = player.x + player.width - 2;
      const top = player.y;
      const bottom = player.y + player.height;

      if (player.vy > 0 && (getBlockAt(left, bottom) !== BLOCKS.AIR || getBlockAt(right, bottom) !== BLOCKS.AIR)) {
        player.y = Math.floor(bottom / BLOCK_SIZE) * BLOCK_SIZE - player.height;
        player.vy = 0;
        player.onGround = true;
      }
      if (player.vy < 0 && (getBlockAt(left, top) !== BLOCKS.AIR || getBlockAt(right, top) !== BLOCKS.AIR)) {
        player.y = Math.floor(top / BLOCK_SIZE) * BLOCK_SIZE + BLOCK_SIZE;
        player.vy = 0;
      }
    }

    // === ОТРИСОВКА ===
    function drawBlock(x, y, blockType) {
      if (blockType === BLOCKS.AIR) return;
      
      const px = x * BLOCK_SIZE;
      const py = y * BLOCK_SIZE;
      const color = BLOCK_COLORS[blockType];

      ctx.fillStyle = color;
      ctx.fillRect(px, py, BLOCK_SIZE, BLOCK_SIZE);

      // Текстура
      ctx.strokeStyle = 'rgba(0,0,0,0.3)';
      ctx.lineWidth = 1;
      ctx.strokeRect(px + 1, py + 1, BLOCK_SIZE - 2, BLOCK_SIZE - 2);

      // Детали для разных блоков
      if (blockType === BLOCKS.GRASS) {
        ctx.fillStyle = '#228B22';
        ctx.fillRect(px, py, BLOCK_SIZE, 6);
      }
      if (blockType === BLOCKS.WOOD_WALL) {
        ctx.strokeStyle = '#8B4513';
        ctx.lineWidth = 1;
        for (let i = 4; i < BLOCK_SIZE; i += 8) {
          ctx.beginPath();
          ctx.moveTo(px + i, py);
          ctx.lineTo(px + i, py + BLOCK_SIZE);
          ctx.stroke();
        }
      }
      if (blockType === BLOCKS.ROOF) {
        ctx.fillStyle = '#A52A2A';
        ctx.beginPath();
        ctx.moveTo(px, py + BLOCK_SIZE);
        ctx.lineTo(px + BLOCK_SIZE / 2, py);
        ctx.lineTo(px + BLOCK_SIZE, py + BLOCK_SIZE);
        ctx.fill();
      }
      if (blockType === BLOCKS.DOOR) {
        ctx.fillStyle = '#D2691E';
        ctx.fillRect(px + 4, py, BLOCK_SIZE - 8, BLOCK_SIZE);
        ctx.fillStyle = '#FFD700';
        ctx.fillRect(px + BLOCK_SIZE - 10, py + BLOCK_SIZE / 2 - 2, 4, 4);
      }
      if (blockType === BLOCKS.WINDOW) {
        ctx.fillStyle = '#87CEEB';
        ctx.fillRect(px + 6, py + 6, BLOCK_SIZE - 12, BLOCK_SIZE - 12);
        ctx.strokeStyle = '#654321';
        ctx.lineWidth = 2;
        ctx.strokeRect(px + 6, py + 6, BLOCK_SIZE - 12, BLOCK_SIZE - 12);
        ctx.beginPath();
        ctx.moveTo(px + BLOCK_SIZE / 2, py + 6);
        ctx.lineTo(px + BLOCK_SIZE / 2, py + BLOCK_SIZE - 6);
        ctx.moveTo(px + 6, py + BLOCK_SIZE / 2);
        ctx.lineTo(px + BLOCK_SIZE - 6, py + BLOCK_SIZE / 2);
        ctx.stroke();
      }
      if (blockType === BLOCKS.TREE_LEAVES) {
        ctx.fillStyle = 'rgba(46, 139, 87, 0.7)';
        ctx.beginPath();
        ctx.arc(px + BLOCK_SIZE / 2, py + BLOCK_SIZE / 2, BLOCK_SIZE / 2 + 2, 0, Math.PI * 2);
        ctx.fill();
      }
      if (blockType === BLOCKS.STONE_ORE) {
        ctx.fillStyle = '#A9A9A9';
        ctx.beginPath();
        ctx.arc(px + BLOCK_SIZE / 2, py + BLOCK_SIZE / 2, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#808080';
        ctx.beginPath();
        ctx.arc(px + 10, py + 10, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(px + 22, py + 20, 3, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function drawPlayer() {
      const px = player.x;
      const py = player.y;

      // Тень
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      ctx.fillRect(px + 2, py + player.height - 2, player.width, 4);

      // Тело
      ctx.fillStyle = '#FF6B6B';
      ctx.fillRect(px + 6, py + 12, 12, 18);

      // Голова
      ctx.fillStyle = '#FFD93D';
      ctx.beginPath();
      ctx.arc(px + player.width / 2, py + 8, 10, 0, Math.PI * 2);
      ctx.fill();

      // Глаза
      ctx.fillStyle = '#333';
      const eyeX = px + player.width / 2 + player.facing * 3;
      ctx.beginPath();
      ctx.arc(eyeX + 2, py + 6, 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(eyeX - 4, py + 6, 2, 0, Math.PI * 2);
      ctx.fill();

      // Ноги
      ctx.fillStyle = '#4A90D9';
      ctx.fillRect(px + 7, py + 30, 5, 10);
      ctx.fillRect(px + 14, py + 30, 5, 10);

      // Инструмент в руке
      ctx.fillStyle = '#666';
      if (selectedItem === 'remove') {
        ctx.fillStyle = '#ff4444';
        ctx.fillRect(px + (player.facing > 0 ? 20 : -4), py + 16, 6, 12);
      }
    }

    function drawCursor() {
      if (mouseX < 0 || mouseX >= WORLD_WIDTH || mouseY < 0 || mouseY >= WORLD_HEIGHT) return;
      
      const px = mouseX * BLOCK_SIZE;
      const py = mouseY * BLOCK_SIZE;
      
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 4]);
      ctx.strokeRect(px, py, BLOCK_SIZE, BLOCK_SIZE);
      ctx.setLineDash([]);

      // Иконка действия
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.font = '16px "Segoe UI"';
      ctx.textAlign = 'center';
      const icon = selectedItem === 'remove' ? '💥' : '🔨';
      ctx.fillText(icon, px + BLOCK_SIZE / 2, py - 6);
    }

    function draw() {
      // Небо
      const skyGradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
      skyGradient.addColorStop(0, '#87CEEB');
      skyGradient.addColorStop(0.6, '#B0E0E6');
      skyGradient.addColorStop(1, '#90EE90');
      ctx.fillStyle = skyGradient;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Облака
      ctx.fillStyle = 'rgba(255,255,255,0.6)';
      drawCloud(100, 50, 1);
      drawCloud(400, 80, 0.7);
      drawCloud(700, 40, 1.2);
      drawCloud(1000, 70, 0.8);

      // Солнце
      ctx.fillStyle = '#FFD700';
      ctx.beginPath();
      ctx.arc(1100, 80, 40, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 215, 0, 0.3)';
      ctx.beginPath();
      ctx.arc(1100, 80, 60, 0, Math.PI * 2);
      ctx.fill();

      // Блоки мира
      for (let y = 0; y < WORLD_HEIGHT; y++) {
        for (let x = 0; x < WORLD_WIDTH; x++) {
          drawBlock(x, y, world[y][x]);
        }
      }

      drawPlayer();
      drawCursor();
    }

    function drawCloud(cx, cy, scale) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.scale(scale, scale);
      ctx.beginPath();
      ctx.arc(0, 0, 25, 0, Math.PI * 2);
      ctx.arc(30, -10, 20, 0, Math.PI * 2);
      ctx.arc(55, 0, 25, 0, Math.PI * 2);
      ctx.arc(25, 5, 20, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    // === ИГРОВОЙ ЦИКЛ ===
    function gameLoop() {
      updatePlayer();
      draw();
      requestAnimationFrame(gameLoop);
    }

    // === ЗАПУСК ===
    initWorld();
    updateResourceDisplay();
    gameLoop();

    console.log('🏗️ Игра "Построй свой дом" запущена!');
    console.log('Управление: WASD/Стрелки — движение, Пробел — прыжок, Клик мыши — строить/ломать');
    console.log('Собери дерево и камень, чтобы построить дом!');
  </script>
</body>
